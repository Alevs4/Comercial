<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".EditarFolio">

    <!-- ===================================================== -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:paddingTop="20dp"
        android:paddingBottom="25dp">


        <!-- ================================================= -->
        <!-- TÍTULO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Editar Folios"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold|italic"
            android:layout_marginBottom="10dp" />


        <!-- ================================================= -->
        <!-- LOGO FRUTTITA -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="170dp"
            android:layout_height="75dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/logo_ftts" />

        <!-- ================================================= -->
        <!-- FOLIO -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Folio"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/TxtFolio"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:inputType="number"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="18sp"
            tools:ignore="SpeakableTextPresentCheck" />


        <!-- ================================================= -->
        <!-- CSG -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="CSG"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/TxtCsg"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="18sp"
            tools:ignore="SpeakableTextPresentCheck" />


        <!-- ================================================= -->
        <!-- FECHA -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Fecha"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/TxtFecha"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:clickable="true"
            android:cursorVisible="false"
            android:focusable="false"
            android:gravity="center"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:textSize="18sp"
            tools:ignore="SpeakableTextPresentCheck" />


        <!-- ================================================= -->
        <!-- KILOS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Kilos"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/TxtKilos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:inputType="numberDecimal"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="18sp"
            tools:ignore="SpeakableTextPresentCheck" />


        <!-- ================================================= -->
        <!-- CANTIDAD CAJAS -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Cantidad de cajas"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/TxtCajas"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:inputType="number"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="18sp"
            tools:ignore="SpeakableTextPresentCheck" />


        <!-- ================================================= -->
        <!-- ESTADO -->
        <!-- ================================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Estado"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/TxtEstado"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:gravity="center"
            android:inputType="text"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textSize="18sp"
            tools:ignore="SpeakableTextPresentCheck" />


        <!-- ================================================= -->
        <!-- TURNO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Turno"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTurno"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />


        <!-- ================================================= -->
        <!-- EXPORTADORA -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exportadora"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/SpnExport"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />


        <!-- ================================================= -->
        <!-- ESPECIE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Especie"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/SpnEspecie"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />


        <!-- ================================================= -->
        <!-- VARIEDAD -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView13"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Variedad"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/SpnVariedad"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />


        <!-- ================================================= -->
        <!-- ENVASE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Envase"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/SpnBins"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />


        <!-- ================================================= -->
        <!-- CATEGORÍA -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinCategoria"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />


        <!-- ================================================= -->
        <!-- BOTONES EDITAR Y BUSCAR -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_marginTop="25dp">

            <!-- BOTÓN EDITAR -->

            <Button
                android:id="@+id/BtnGuardar"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:backgroundTint="@android:color/holo_green_dark"
                android:onClick="Actualizar"
                android:text="Editar"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- SEPARACIÓN -->

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />


            <!-- BOTÓN BUSCAR -->

            <Button
                android:id="@+id/BtnCerrarTurno"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:onClick="consultar"
                android:text="Buscar"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- BOTÓN CASA -->
        <!-- ================================================= -->

        <ImageButton
            android:id="@+id/BtnCasa"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/boton_casa"
            android:src="@drawable/ic_casa"
            android:scaleType="centerInside"
            android:padding="15dp"
            android:contentDescription="Volver al menú principal" />


    </LinearLayout>

</ScrollView>