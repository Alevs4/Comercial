<?xml version="1.0" encoding="utf-8"?>


<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".IngresoFruta">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="30dp">

        <!-- ================================================= -->
        <!-- TÍTULO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Ingreso Folios"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold|italic"
            android:layout_marginBottom="15dp" />


        <!-- ================================================= -->
        <!-- LOGO -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/imageView3"
            android:layout_width="170dp"
            android:layout_height="80dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/logo_ftts" />


        <!-- ================================================= -->
        <!-- FOLIO -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/TxtFolio"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Folio"
            android:inputType="number"
            android:textSize="18sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:focusable="false"
            android:clickable="false"
            android:cursorVisible="false"
            android:backgroundTint="@color/black" />

        <!-- ================================================= -->
        <!-- CSG -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/TxtCsg"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:hint="CSG"
            android:inputType="text"
            android:textSize="18sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />


        <!-- ================================================= -->
        <!-- FECHA -->
        <!-- ================================================= -->


        <EditText
            android:id="@+id/TxtFecha"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:hint="Fecha"
            android:focusable="false"
            android:clickable="true"
            android:cursorVisible="false"
            android:textSize="18sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />


        <!-- ================================================= -->
        <!-- KILOS -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/TxtKilos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:hint="Kilos"
            android:inputType="numberDecimal"
            android:textSize="18sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />


        <!-- ================================================= -->
        <!-- CANTIDAD DE CAJAS -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/TxtCajas"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:hint="Cantidad Cajas"
            android:inputType="number"
            android:textSize="18sp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />


        <!-- ================================================= -->
        <!-- TURNO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView9"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="15dp"
            android:text="Turno"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spTurno"
            android:layout_width="match_parent"
            android:layout_height="60dp" />


        <!-- ================================================= -->
        <!-- EXPORTADORA -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView11"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Exportadora"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/SpnExport"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />


        <!-- ================================================= -->
        <!-- ESPECIE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView12"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Especie"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/SpnEspecie"
            android:layout_width="match_parent"
            android:layout_height="60dp" />


        <!-- ================================================= -->
        <!-- VARIEDAD -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView13"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Variedad"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/SpnVariedad"
            android:layout_width="match_parent"
            android:layout_height="60dp" />


        <!-- ================================================= -->
        <!-- ENVASE -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Envase"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/SpnBins"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />


        <!-- ================================================= -->
        <!-- CATEGORÍA -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textView15"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Categoría"
            android:textColor="@color/black"
            android:textSize="17sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/spinCategoria"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:spinnerMode="dialog" />


        <!-- ================================================= -->
        <!-- BOTONES -->
        <!-- ================================================= -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:orientation="horizontal"
            android:weightSum="2">

            <!-- GUARDAR -->

            <Button
                android:id="@+id/BtnGuardar"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:backgroundTint="@android:color/holo_green_dark"
                android:onClick="Registrar"
                android:text="Guardar"
                android:textColor="@color/white"
                android:textSize="18sp"
                android:textStyle="bold" />


            <!-- ESPACIO -->

            <Space
                android:layout_width="12dp"
                android:layout_height="1dp" />


            <!-- CERRAR TURNO -->

            <Button
                android:id="@+id/BtnCerrarTurno"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:onClick="Turno"
                android:text="Cerrar Turno"
                android:textSize="18sp"
                android:textStyle="bold" />

        </LinearLayout>


        <!-- ================================================= -->
        <!-- ESPACIO -->
        <!-- ================================================= -->

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />


        <!-- ================================================= -->
        <!-- BOTÓN CASA -->
        <!-- ================================================= -->
        <!--
             Por ahora NO le ponemos onClick.
             Cuando vea tu IngresoFruta.java agregaremos
             el código de volver a Inicio sin romper nada.
        -->

        <ImageButton
            android:id="@+id/BtnCasa"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/boton_casa"
            android:src="@drawable/ic_casa"
            android:scaleType="centerInside"
            android:padding="15dp"
            android:contentDescription="Volver al menú principal" />

    </LinearLayout>

</ScrollView>