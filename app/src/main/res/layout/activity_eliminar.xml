<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".Eliminar">

    <!-- ===================================================== -->
    <!-- CONTENEDOR PRINCIPAL -->
    <!-- ===================================================== -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="25dp"
        android:paddingEnd="25dp"
        android:paddingTop="20dp"
        android:paddingBottom="25dp">


        <!-- ================================================= -->
        <!-- TÍTULO -->
        <!-- ================================================= -->

        <TextView
            android:id="@+id/textViewEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Eliminar Registro"
            android:textColor="@color/black"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="15dp" />


        <!-- ================================================= -->
        <!-- LOGO -->
        <!-- ================================================= -->

        <ImageView
            android:id="@+id/imageViewEliminar"
            android:layout_width="170dp"
            android:layout_height="75dp"
            android:layout_gravity="center"
            android:layout_marginBottom="20dp"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/logo_ftts" />


        <!-- ================================================= -->
        <!-- FOLIO -->
        <!-- ================================================= -->
        <!--
             Este es el único campo donde el usuario puede
             escribir.
        -->

        <EditText
            android:id="@+id/TxtEliminarFolio"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:hint="Folio"
            android:inputType="number"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp" />


        <!-- ================================================= -->
        <!-- EXPORTADORA -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/TxtEliminarProductor"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:hint="Exportadora"
            android:enabled="false"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="18sp" />


        <!-- ================================================= -->
        <!-- VARIEDAD -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/TxtEliminarVariedad"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:hint="Variedad"
            android:enabled="false"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="18sp" />


        <!-- ================================================= -->
        <!-- KILOS -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/TxtEliminarKilos"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:hint="Kilos"
            android:enabled="false"
            android:gravity="center"
            android:inputType="numberDecimal"
            android:textColor="@color/black"
            android:textSize="18sp" />


        <!-- ================================================= -->
        <!-- CATEGORÍA -->
        <!-- ================================================= -->

        <EditText
            android:id="@+id/TxtEliminarCategoria"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="8dp"
            android:hint="Categoría"
            android:enabled="false"
            android:gravity="center"
            android:textColor="@color/black"
            android:textSize="18sp" />


        <!-- ================================================= -->
        <!-- BOTÓN BUSCAR -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/BtnBuscarEliminar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="30dp"
            android:backgroundTint="#4000C8"
            android:onClick="Buscar"
            android:text="Buscar"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- BOTÓN ELIMINAR -->
        <!-- ================================================= -->

        <Button
            android:id="@+id/BtnEliminar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="20dp"
            android:backgroundTint="#D00000"
            android:onClick="Eliminar"
            android:text="Eliminar"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />


        <!-- ================================================= -->
        <!-- BOTÓN CASA -->
        <!-- ================================================= -->

        <ImageButton
            android:id="@+id/BtnCasa"
            android:layout_width="75dp"
            android:layout_height="75dp"
            android:layout_gravity="center"
            android:layout_marginTop="10dp"
            android:background="@drawable/boton_casa"
            android:src="@drawable/ic_casa"
            android:scaleType="centerInside"
            android:padding="15dp"
            android:contentDescription="Volver al menú principal" />

    </LinearLayout>

</ScrollView>